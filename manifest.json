{
  "manifest_version": 3,
  "name": "Vivaldi Tab Productivity Tracker & Focus Suite",
  "version": "2.3.0",
  "description": "Monitoramento de produtividade, telemetria contínua, modo Pomodoro e painel lateral nativo para Vivaldi.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Produtividade & Foco Vivaldi"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "styles.css", "popup.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
